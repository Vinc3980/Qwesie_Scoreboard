# Server environment variables (copy to server/.env)
# See docs/ENVIRONMENT_VARIABLES.md for the full table and notes.

# --- Core ---
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/qwesie_tv?schema=public"
# Optional direct (non-pooled) URL for Prisma Migrate/pg_dump. Neon: the host
# without "-pooler". Falls back to DATABASE_URL when unset.
# DATABASE_URL_UNPOOLED=

# Comma-separated allowed origins. The server also auto-allows private LAN/dev/server-port origins
# (localhost/127.0.0.1 and RFC1918 addresses on dev/server/common ports) to support match-day LAN use.
CORS_ORIGIN="http://localhost:5173"

# Optional client serving (production/same-port)
# CLIENT_DIST_DIR=
# SERVE_CLIENT=
UPLOADS_DIR="uploads"

# --- Auth / security ---
# Use a long random secret in production (>= 32 chars). Server refuses weak/default secret in production.
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_COOKIE_NAME="qwesie_token"
# DEV_AUTO_LOGIN=true only for local development convenience (non-production, real non-VIEWER role)
DEV_AUTO_LOGIN=false
ALLOW_SCORER_PIN=false
BOOTSTRAP_SETUP_TOKEN=

# --- Optional SMTP password reset ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
# Base URL used in reset links, e.g. http://192.168.1.50:5000
APP_BASE_URL=

# --- Backups ---
BACKUP_DIR="backups"
BACKUP_INTERVAL_MINUTES=5
BACKUP_ON_START=true
BACKUP_KEEP=48
BACKUP_KEEP_DAILY_DAYS=7
# Configure for Windows/Linux as needed (command name on PATH or absolute path)
PG_DUMP_PATH="pg_dump"
PG_RESTORE_PATH="psql"

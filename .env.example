# Qwesie TV - environment configuration
#
# Copy this file to `.env` (repo root) or `server/.env` as needed.
# The server loads `server/.env` and then the repo-root `.env` (see server/src/config/env.ts).
# Client development uses the Vite proxy by default; see client/.env.example for optional overrides.
#
# For a complete reference, see docs/ENVIRONMENT_VARIABLES.md

# --- Server / API ---
# PORT=5000
# NODE_ENV=development                  # development | production | test
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/qwesie_tv?schema=public
# DATABASE_URL_UNPOOLED=                # optional direct URL for migrations/pg_dump (Neon); falls back to DATABASE_URL
# CORS_ORIGIN=http://localhost:5173     # comma-separated origins; LAN/dev/server ports are auto-covered by server
# CLIENT_DIST_DIR=                      # optional absolute/relative path to built client dist (production serving)
# SERVE_CLIENT=                         # true/false; defaults to true in production
# UPLOADS_DIR=uploads                   # logos/media uploads directory

# --- Auth / security ---
# JWT_SECRET=change-me-to-a-long-random-secret   # REQUIRED in production (>=32 chars, not default)
# JWT_COOKIE_NAME=qwesie_token
# DEV_AUTO_LOGIN=false                  # dev only: auto-login as non-VIEWER scorer (never use in production)
# ALLOW_SCORER_PIN=false

# --- Optional SMTP (password reset email layer) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false
# APP_BASE_URL=                         # public/base URL used in reset links (e.g. http://<lan-ip>:5000)

# --- Backups (PostgreSQL pg_dump/psql) ---
# BACKUP_DIR=backups
# BACKUP_INTERVAL_MINUTES=5             # periodic backup while live/ready matches exist
# BACKUP_ON_START=true
# BACKUP_KEEP=48                        # keep N most recent backups
# BACKUP_KEEP_DAILY_DAYS=7              # also keep one backup per day for last D days
# PG_DUMP_PATH=pg_dump                  # command name or absolute path
# PG_RESTORE_PATH=psql                  # command name or absolute path (used for restore docs/scripts)

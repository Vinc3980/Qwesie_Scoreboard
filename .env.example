# Qwesie TV - environment configuration
#
# Copy this file to `.env` (repo root) or `server/.env` as needed.
# The server loads `server/.env` and then the repo-root `.env` (see server/src/config/env.ts).
# Client development uses the Vite proxy by default; see client/.env.example for optional overrides.
#
# For a complete reference, see docs/ENVIRONMENT_VARIABLES.md

# --- Server / API ---
# PORT=5000
# NODE_ENV=development                  # development | production | test
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/qwesie_tv?schema=public
# DIRECT_URL=                           # direct (non-pooled) URL for Prisma Migrate; Neon: same as DATABASE_URL without -pooler
# DATABASE_URL_UNPOOLED=                # legacy alias for DIRECT_URL
# DB_CONNECTION_LIMIT=5                 # app pool size; keep small on single Render instance with Neon PgBouncer
# DIAGNOSTICS=false                     # enable Prisma query durations + /api/v1/health/metrics
# KEEPWARM_ENABLED=false                # event-day only: SELECT 1 every KEEPWARM_INTERVAL_MINUTES to reduce Neon cold starts
# KEEPWARM_INTERVAL_MINUTES=4
# CORS_ORIGIN=http://localhost:5173     # comma-separated origins; LAN/dev/server ports are auto-covered by server
# CLIENT_DIST_DIR=                      # optional absolute/relative path to built client dist (production serving)
# SERVE_CLIENT=                         # true/false; defaults to true in production
# UPLOADS_DIR=uploads                   # logos/media uploads directory (local dev only; production should use S3)
# STORAGE_DRIVER=local                  # local | s3 (s3 = durable; local is ephemeral on Render)
# STORAGE_BUCKET=                       # bucket name, e.g. qwesie-media
# STORAGE_ENDPOINT=                     # S3 endpoint; falls back to AWS_ENDPOINT_URL_S3 (Neon)
# STORAGE_REGION=auto                   # falls back to AWS_REGION (Neon)
# STORAGE_ACCESS_KEY_ID=                # falls back to AWS_ACCESS_KEY_ID (Neon)
# STORAGE_SECRET_ACCESS_KEY=            # falls back to AWS_SECRET_ACCESS_KEY (Neon)
# STORAGE_PUBLIC_BASE_URL=              # public_read base URL; auto-derived as <endpoint>/<bucket> when empty

# --- Auth / security ---
# JWT_SECRET=change-me-to-a-long-random-secret   # REQUIRED in production (>=32 chars, not default)
# JWT_COOKIE_NAME=qwesie_token
# DEV_AUTO_LOGIN=false                  # dev only: auto-login as non-VIEWER scorer (never use in production)
# ALLOW_SCORER_PIN=false

# --- Optional SMTP (password reset email layer) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false
# APP_BASE_URL=                         # public/base URL used in reset links (e.g. http://<lan-ip>:5000)

# --- Backups ---
# Hosted Neon/Render: keep local pg_dump backups disabled and use Neon branching / point-in-time restore.
# BACKUP_ENABLED=false
# BACKUP_DIR=backups
# BACKUP_INTERVAL_MINUTES=60
# BACKUP_ON_START=false
# BACKUP_KEEP=48
# BACKUP_KEEP_DAILY_DAYS=7
# PG_DUMP_PATH=pg_dump
# PG_RESTORE_PATH=psql

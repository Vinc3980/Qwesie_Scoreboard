# Client environment variables (optional)
# In development, Vite proxies /api and /socket.io to the backend (see client/vite.config.ts),
# so no variables are required for the default local setup.
#
# Set these only when the client is served separately and cannot use the dev proxy:
# VITE_API_BASE_URL=http://localhost:5000/api/v1
# VITE_SOCKET_URL=http://localhost:5000
#
# Production builds typically run on the same origin/port as the server (SERVE_CLIENT=true),
# so explicit API/socket URLs are usually unnecessary.
